# Copy to .env.local for local development.
# On Cloudflare Pages: Settings -> Variables and Secrets (Production + Preview).
# NEXT_PUBLIC_* values are inlined at BUILD time, so redeploy after changing them.

# Web3Forms access key (public by design). Get one at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=https://smartsolsystems.in

# Canonical site URL, no trailing slash. Overrides seo.siteUrl in site.config.ts.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Cloudflare Turnstile SITE key (public). Only used if
# leadForm.captcha.provider = "turnstile". The SECRET key goes in the
# Web3Forms dashboard, never in this repo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
